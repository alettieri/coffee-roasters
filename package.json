{
  "name": "coffee-roasters",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "build": "nuxt build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrations:check && pnpm test:integration && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:integration:reset": "pnpm db:integration:stop && pnpm db:integration:start",
    "db:integration:start": "docker compose -p coffee-roasters-integration -f docker-compose.integration.yml up -d --wait postgres-integration",
    "db:integration:stop": "docker compose -p coffee-roasters-integration -f docker-compose.integration.yml down --volumes --remove-orphans",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:migrate:integration": "env -u DATABASE_URL -u MIGRATION_DATABASE_URL ENV_FILE=.env.test tsx scripts/database/migrate.ts",
    "db:migrations:check": "tsx scripts/database/check-migrations.ts",
    "db:reset": "docker compose down --volumes --remove-orphans && docker compose up -d --wait postgres && pnpm db:migrate",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose down",
    "dev": "nuxt dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "postinstall": "nuxt prepare",
    "test": "pnpm test:unit",
    "test:acceptance": "playwright test",
    "test:integration": "pnpm db:integration:reset && pnpm db:migrate:integration && env -u DATABASE_URL -u MIGRATION_DATABASE_URL ENV_FILE=.env.test vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "pnpm db:migrate && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "nuxt": "4.4.8",
    "postgres": "3.4.9",
    "vue": "3.5.38",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5",
    "wrangler": "4.104.0"
  }
}
