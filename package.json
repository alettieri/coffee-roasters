  "dependencies": {
    "nuxt": "4.4.8",
    "vue": "3.5.38"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/node": "26.0.0",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5",
    "wrangler": "4.104.0"
  }
}
